# Application
APP_NAME=HR Multi-Agentic System
APP_ENV=development
DEBUG=true

# Database
# Docker Compose (backend container): postgresql://hr_user:hr_password@db:5432/hr_platform
# Local uvicorn on Windows: postgresql://hr_user:hr_password@127.0.0.1:5433/hr_platform
DATABASE_URL=postgresql://hr_user:hr_password@127.0.0.1:5433/hr_platform

# Security
SECRET_KEY=change-me-to-a-random-secret-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS
CORS_ORIGINS=http://localhost:3000

# Seed admin user
SEED_ADMIN_EMAIL=admin@hr-platform.local
SEED_ADMIN_PASSWORD=admin123

# AI layer (LLM providers — backend only)
AI_LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# RAG foundation (no secrets — embedding API key is GEMINI_API_KEY above)
RAG_EMBEDDING_MODEL=gemini-embedding-2
RAG_EMBEDDING_DIMENSIONS=768
RAG_VECTOR_DISTANCE=cosine
# Chunk size/overlap are whitespace-separated word counts (deterministic approx)
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=100
# Max pending texts per EmbeddingService pass (provider still 1 SDK call/text for embedding-2)
RAG_EMBED_MAX_BATCH_SIZE=32
# Secure vector retrieval (cosine distance in PostgreSQL)
RAG_RETRIEVAL_TOP_K=5
RAG_RETRIEVAL_MAX_TOP_K=20
# Optional; leave empty to disable threshold filtering
# RAG_RETRIEVAL_MIN_SIMILARITY=
# Hybrid search (vector + FTS + RRF); FTS uses PostgreSQL 'simple' config (EN/FR)
RAG_RRF_K=60
RAG_HYBRID_VECTOR_CANDIDATES=20
RAG_HYBRID_FTS_CANDIDATES=20
RAG_HYBRID_MAX_CANDIDATES=50
# RAG query pipeline (embed query → hybrid retrieve → context; no generation)
RAG_QUERY_MAX_CHARACTERS=1000
RAG_CONTEXT_MAX_CHUNKS=5
RAG_CONTEXT_MAX_CHARACTERS=12000
# Grounded generation (conversational model via AI_LLM_PROVIDER / GEMINI_MODEL)
RAG_GENERATION_MAX_OUTPUT_TOKENS=500
RAG_GENERATION_TEMPERATURE=0.1

# AWS S3 (backend only — never expose these to the frontend)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-north-1
AWS_S3_BUCKET_NAME=hr-platform-documents-pfe
