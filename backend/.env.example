# Application
APP_NAME=HR Multi-Agentic System
APP_ENV=development
DEBUG=true

# Database
# Docker Compose (backend container): postgresql://hr_user:hr_password@db:5432/hr_platform
# Local uvicorn on Windows: postgresql://hr_user:hr_password@127.0.0.1:5433/hr_platform
DATABASE_URL=postgresql://hr_user:hr_password@127.0.0.1:5433/hr_platform

# Security
SECRET_KEY=change-me-to-a-random-secret-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS
CORS_ORIGINS=http://localhost:3000

# Seed admin user
SEED_ADMIN_EMAIL=admin@hr-platform.local
SEED_ADMIN_PASSWORD=admin123

# AI layer (LLM providers — backend only)
AI_LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# RAG foundation (no secrets — embedding API keys use Gemini settings later)
RAG_EMBEDDING_MODEL=gemini-embedding-2
RAG_EMBEDDING_DIMENSIONS=768
RAG_VECTOR_DISTANCE=cosine
# Chunk size/overlap are whitespace-separated word counts (deterministic approx)
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=100

# AWS S3 (backend only — never expose these to the frontend)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-north-1
AWS_S3_BUCKET_NAME=hr-platform-documents-pfe
